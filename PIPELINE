make_volcano <- function(
    res,
    comparison_name,
    filename
) {
  
  
  df <- annotate_DE_results(
    res
  )
  
  
  ##########################################################
  # REMOVE MISSING VALUES
  ##########################################################
  
  df <- df[
    
    !is.na(df$log2FoldChange) &
      !is.na(df$padj),
    
    ,
    drop = FALSE
    
  ]
  
  
  ##########################################################
  # LABEL SIGNIFICANT GENES
  ##########################################################
  
  significant <- (
    
    df$padj < 0.05 &
      abs(df$log2FoldChange) >= 1
    
  )
  
  
  df$label <- NA_character_
  
  
  df$label[
    significant
  ] <- df$Gene_Name[
    significant
  ]
  
  
  ##########################################################
  # PLOT
  ##########################################################
  
  png(
    
    filename,
    
    width = 1500,
    height = 1200,
    res = 150
    
  )
  
  
  p <- EnhancedVolcano(
    
    df,
    
    lab = df$label,
    
    x = "log2FoldChange",
    
    y = "padj",
    
    pCutoff = 0.05,
    
    FCcutoff = 1,
    
    title = comparison_name,
    
    subtitle =
      "Labels: padj < 0.05 and |log2FC| ≥ 1",
    
    pointSize = 1.5,
    
    labSize = 3.5,
    
    drawConnectors = TRUE,
    
    widthConnectors = 0.4,
    
    max.overlaps = 50,
    
    legendPosition = "bottom"
    
  ) +
    
    theme(
      
      axis.title.x = element_text(
        size = 16,
        face = "bold"
      ),
      
      axis.title.y = element_text(
        size = 16,
        face = "bold"
      ),
      
      axis.text = element_text(
        size = 13
      ),
      
      plot.title = element_text(
        size = 17,
        face = "bold"
      ),
      
      plot.subtitle = element_text(
        size = 11
      )
      
    )
  
  
  print(p)
  
  
  dev.off()
  
}


