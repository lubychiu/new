############################################################

make_DE_heatmap <- function(
    res,
    comparison_name,
    filename,
    n_genes = 50
) {
  
  
  df <- annotate_DE_results(
    res
  )
  
  
  ##########################################################
  # SELECT SIGNIFICANT GENES
  ##########################################################
  
  sig <- df[
    
    !is.na(df$padj) &
      df$padj < 0.05 &
      !is.na(df$log2FoldChange) &
      abs(df$log2FoldChange) >= 1,
    
    ,
    drop = FALSE
    
  ]
  
  
  if (nrow(sig) == 0) {
    
    print(
      paste(
        "No significant genes for:",
        comparison_name
      )
    )
    
    return(NULL)
    
  }
  
  
  ##########################################################
  # SORT BY ADJUSTED P-VALUE
  ##########################################################
  
  sig$padj_numeric <-
    as.numeric(
      sig$padj
    )
  
  
  sig <- sig[
    
    order(
      sig$padj_numeric,
      na.last = TRUE
    ),
    
    ,
    drop = FALSE
    
  ]
  
  
  ##########################################################
  # SELECT TOP GENES
  ##########################################################
  
  selected_ids <- head(
    
    sig$Systematic_ID,
    
    n_genes
    
  )
  
  
  selected_ids <- intersect(
    
    selected_ids,
    
    rownames(vst_matrix)
    
  )
  
  
  if (length(selected_ids) == 0) {
    
    print(
      paste(
        "No genes available for heatmap:",
        comparison_name
      )
    )
    
    return(NULL)
    
  }
  
  
  ##########################################################
  # CREATE EXPRESSION MATRIX
  ##########################################################
  
  heatmap_data <- vst_matrix[
    
    selected_ids,
    
    ,
    drop = FALSE
    
  ]
  
  
  ##########################################################
  # Z-SCORE EACH GENE
  ##########################################################
  
  heatmap_scaled <- t(
    
    scale(
      t(
        heatmap_data
      )
    )
    
  )
  
  
  ##########################################################
  # REPLACE SAMPLE NAMES
  ##########################################################
  
  colnames(heatmap_scaled) <-
    metadata$Display_Name[
      match(
        colnames(heatmap_scaled),
        rownames(metadata)
      )
    ]
  
  
  ##########################################################
  # REPLACE GENE IDS WITH GENE NAMES
  ##########################################################
  
  heatmap_gene_names <- gene_annotation$Gene_Name[
    
    match(
      selected_ids,
      gene_annotation$Systematic_ID
    )
    
  ]
  
  
  missing_names <- (
    
    is.na(heatmap_gene_names) |
      heatmap_gene_names == ""
    
  )
  
  
  heatmap_gene_names[
    missing_names
  ] <- selected_ids[
    missing_names
  ]
  
  
  rownames(heatmap_scaled) <-
    make.unique(
      heatmap_gene_names
    )
  
  
  ##########################################################
  # SAMPLE ANNOTATION
  ##########################################################
  
  heatmap_annotation <- metadata[
    
    colnames(vst_matrix),
    
    c(
      "Genotype",
      "Pi",
      "Condition"
    ),
    
    drop = FALSE
    
  ]
  
  
  rownames(heatmap_annotation) <-
    metadata$Display_Name[
      match(
        rownames(heatmap_annotation),
        rownames(metadata)
      )
    ]
  
  
  ##########################################################
  # PLOT
  ##########################################################
  
  png(
    
    filename,
    
    width = 1300,
    height = 1500,
    res = 150
    
  )
  
  
  pheatmap(
    
    heatmap_scaled,
    
    annotation_col =
      heatmap_annotation,
    
    cluster_rows = TRUE,
    
    cluster_cols = TRUE,
    
    show_rownames = TRUE,
    
    fontsize_row = 8,
    
    fontsize_col = 9,
    
    main = paste(
      comparison_name,
      "\nTop significant genes"
    )
    
  )
  
  
  dev.off()
  
}


