    "1. WT-Pi vs WT+Pi"
  )
  
  print(
    "2. KCS1+Pi vs WT+Pi"
  )
  
  print(
    "3. KCS1-Pi vs WT+Pi"
  )
  
  print(
    "4. KCS1+Pi vs WT-Pi"
  )
  
  print(
    "5. KCS1-Pi vs WT-Pi"
  )
  
  print(
