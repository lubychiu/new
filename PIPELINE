############################################################
# CANDIDA ALBICANS RNA-seq ANALYSIS
#
# EXPERIMENT:
#
# WT   +Pi
# WT   -Pi
# kcs1 +Pi
# kcs1 -Pi
#
# 3 biological replicates per condition
# 12 samples total
#
# MAIN BIOLOGICAL QUESTION:
#
# Does loss of KCS1 alter the transcriptional response
# to phosphate starvation?
#
# IMPORTANT:
#
# DESeq2 uses ALL 12 biological replicates independently.
#
# Replicates are averaged ONLY for condition-level
# visualization using VST expression values.
#
# Gene IDs are mapped to Candida Genome Database gene names.
############################################################


############################################################
# 0. INSTALL / LOAD REQUIRED PACKAGES
############################################################

if (!requireNamespace("BiocManager", quietly = TRUE)) {
  install.packages("BiocManager")
}

# Uncomment if packages are not installed:
#
# BiocManager::install("DESeq2")
# BiocManager::install("EnhancedVolcano")
# BiocManager::install("pheatmap")
#
# install.packages(c(
#   "ggplot2",
#   "ggrepel",
#   "dplyr",
#   "tidyr",
#   "tibble",
#   "matrixStats"
# ))

library(DESeq2)
library(EnhancedVolcano)
library(pheatmap)
library(ggplot2)
library(ggrepel)
library(dplyr)
library(tidyr)
library(tibble)
library(matrixStats)


############################################################
# 1. CREATE OUTPUT DIRECTORIES
############################################################

output_dir <- "RNAseq_DE_Results"

dir.create(
  output_dir,
  showWarnings = FALSE,
  recursive = TRUE
)

dir.create(
  file.path(output_dir, "01_QC"),
  showWarnings = FALSE,
  recursive = TRUE
)

dir.create(
  file.path(output_dir, "02_DE_results"),
  showWarnings = FALSE,
  recursive = TRUE
)

dir.create(
  file.path(output_dir, "03_Volcano"),
  showWarnings = FALSE,
  recursive = TRUE
)

dir.create(
  file.path(output_dir, "04_MA_plots"),
  showWarnings = FALSE,
  recursive = TRUE
)

dir.create(
  file.path(output_dir, "05_Heatmaps"),
  showWarnings = FALSE,
  recursive = TRUE
)

dir.create(
  file.path(output_dir, "06_PCA"),
  showWarnings = FALSE,
  recursive = TRUE
)

dir.create(
  file.path(output_dir, "07_Sample_correlations"),
  showWarnings = FALSE,
  recursive = TRUE
)

dir.create(
  file.path(output_dir, "08_Significant_gene_lists"),
  showWarnings = FALSE,
  recursive = TRUE
)

dir.create(
  file.path(output_dir, "09_Response_analysis"),
  showWarnings = FALSE,
  recursive = TRUE
)


############################################################
# 2. LOAD CANDIDA GENOME DATABASE ANNOTATION
############################################################
#
# cgd_features.tab should contain:
#
# Column 1 = Systematic ID
# Column 2 = Gene name
# Column 4 = Feature type
#
############################################################

print("======================================================")
print("LOADING CGD GENE ANNOTATION")
print("======================================================")

if (!file.exists("cgd_features.tab")) {
  
  stop(
    paste0(
      "\nERROR: cgd_features.tab was not found.\n",
      "Place cgd_features.tab in the same working directory ",
      "as this R script.\n"
    )
  )
  
}

cgd_raw <- read.table(
  "cgd_features.tab",
  header = FALSE,
  sep = "\t",
  quote = "",
  comment.char = "!",
  fill = TRUE,
  stringsAsFactors = FALSE
)


############################################################
# CREATE CGD MAPPING TABLE
############################################################

mapping_table <- data.frame(
  
  systematic_id = trimws(
    as.character(cgd_raw[, 1])
  ),
  
  gene_symbol = trimws(
    as.character(cgd_raw[, 2])
  ),
  
  feature_type = trimws(
    as.character(cgd_raw[, 4])
  ),
  
  stringsAsFactors = FALSE
  
)


############################################################
# CLEAN EMPTY GENE NAME FIELDS
############################################################

mapping_table$gene_symbol[
  mapping_table$gene_symbol == "" |
    mapping_table$gene_symbol ==
    mapping_table$systematic_id
] <- NA


############################################################
# FUNCTION TO NORMALIZE SYSTEMATIC IDs
############################################################

normalize_id <- function(x) {
  
  toupper(
    gsub(
      "[_\\-]",
      "",
      trimws(x)
    )
  )
  
}


############################################################
# CREATE NORMALIZED CGD IDs
############################################################

mapping_table$id_norm <- normalize_id(
  mapping_table$systematic_id
)


############################################################
# REMOVE DUPLICATE MAPPING ENTRIES
#
# Entries with actual gene names are preferred.
############################################################

mapping_table <- mapping_table[
  order(
    is.na(mapping_table$gene_symbol)
  ),
  ,
  drop = FALSE
]

mapping_table <- mapping_table[
  !duplicated(mapping_table$id_norm),
  ,
  drop = FALSE
]


############################################################
# PRINT ANNOTATION SUMMARY
############################################################

print(
  paste(
    "Total CGD features:",
    nrow(mapping_table)
  )
)

print(
  paste(
    "CGD features with gene names:",
    sum(
      !is.na(mapping_table$gene_symbol)
    )
  )
)


############################################################
# 3. LOAD FEATURECOUNTS MATRIX
############################################################

print("======================================================")
print("LOADING FEATURECOUNTS MATRIX")
print("======================================================")

if (!file.exists("candida_counts_matrix.txt")) {
  
  stop(
    paste0(
      "\nERROR: candida_counts_matrix.txt was not found.\n",
      "Place it in the same working directory as this script.\n"
    )
  )
  
}

counts_raw <- read.delim(
  "candida_counts_matrix.txt",
  header = TRUE,
  comment.char = "#",
  check.names = FALSE,
  quote = "",
  stringsAsFactors = FALSE
)


############################################################
# CHECK COLUMN COUNT
############################################################

print(
  paste(
    "Total columns detected:",
    ncol(counts_raw)
  )
)

print("Column names detected:")
print(colnames(counts_raw))


############################################################
# EXPECTED STRUCTURE:
#
# 1  Geneid
# 2  Chr
# 3  Start
# 4  End
# 5  Strand
# 6  Length
# 7-18 = 12 samples
#
# TOTAL = 18 COLUMNS
############################################################

if (ncol(counts_raw) != 18) {
  
  stop(
    paste0(
      "\nERROR: Expected exactly 18 columns.\n\n",
      "Expected:\n",
      "6 featureCounts annotation columns + ",
      "12 RNA-seq sample columns = 18 total.\n\n",
      "Your file contains ",
      ncol(counts_raw),
      " columns.\n"
    )
  )
  
}


############################################################
# CHECK FOR EMPTY COLUMN NAMES
############################################################

original_names <- colnames(counts_raw)

empty_names <- which(
  is.na(original_names) |
    trimws(original_names) == ""
)

if (length(empty_names) > 0) {
  
  print(
    paste(
      "WARNING: Empty column names detected at:",
      paste(empty_names, collapse = ", ")
    )
  )
  
  for (i in empty_names) {
    original_names[i] <- paste0(
      "Sample_",
      i
    )
  }
  
  colnames(counts_raw) <- original_names
  
}


############################################################
# EXTRACT THE 12 SAMPLE COLUMNS
############################################################

sample_columns <- 7:18

original_sample_names <- colnames(
  counts_raw
)[sample_columns]

print("======================================================")
print("ORIGINAL SAMPLE NAMES")
print("======================================================")

print(original_sample_names)


############################################################
# CHECK FOR DUPLICATE SAMPLE NAMES
############################################################

if (anyDuplicated(original_sample_names) > 0) {
  
  print(
    "WARNING: Duplicate sample names detected."
  )
  
  original_sample_names <- make.unique(
    original_sample_names
  )
  
  colnames(
    counts_raw
  )[sample_columns] <- original_sample_names
  
}


############################################################
# EXTRACT GENE IDS AND COUNTS
############################################################

counts_clean <- counts_raw[
  ,
  c(1, sample_columns),
  drop = FALSE
]

colnames(counts_clean)[1] <- "Geneid"


############################################################
# CONVERT COUNT COLUMNS TO NUMERIC
############################################################

for (i in 2:ncol(counts_clean)) {
  
  counts_clean[[i]] <- as.numeric(
    as.character(
      counts_clean[[i]]
    )
  )
  
}


############################################################
# CHECK FOR NA VALUES
############################################################

if (any(is.na(counts_clean[, -1]))) {
  
  na_count <- sum(
    is.na(
      counts_clean[, -1]
    )
  )
  
  stop(
    paste0(
      "\nERROR: ",
      na_count,
      " NA values detected in the count matrix.\n",
      "Check the featureCounts file.\n"
    )
  )
  
}


############################################################
# COLLAPSE DUPLICATE GENE IDS
############################################################

print("Collapsing duplicate gene IDs...")

counts_fixed <- aggregate(
  . ~ Geneid,
  data = counts_clean,
  FUN = sum
)


############################################################
# 4. REMOVE tRNA / rRNA FEATURES
############################################################

print("======================================================")
print("FILTERING tRNA / rRNA FEATURES")
print("======================================================")


############################################################
# NORMALIZE COUNT MATRIX IDs
############################################################

stripped_keys <- gsub(
  "^CAALFM_",
  "",
  counts_fixed$Geneid
)

normalized_matrix_keys <- normalize_id(
  stripped_keys
)


############################################################
# MATCH FEATURE TYPES FROM CGD
############################################################

matched_features <- mapping_table$feature_type[
  match(
    normalized_matrix_keys,
    mapping_table$id_norm
  )
]


############################################################
# IDENTIFY tRNA / rRNA FEATURES
############################################################

is_trna_rrna <- (
  
  grepl(
    "tRNA|rRNA",
    counts_fixed$Geneid,
    ignore.case = TRUE
  ) |
    
    grepl(
      "tRNA|rRNA",
      matched_features,
      ignore.case = TRUE
    )
  
)


############################################################
# PRINT FILTERING SUMMARY
############################################################

print(
  paste(
    "Features before tRNA/rRNA filtering:",
    nrow(counts_fixed)
  )
)

print(
  paste(
    "tRNA/rRNA features removed:",
    sum(is_trna_rrna)
  )
)


############################################################
# REMOVE NON-CODING FEATURES
############################################################

counts_fixed <- counts_fixed[
  !is_trna_rrna,
  ,
  drop = FALSE
]


print(
  paste(
    "Features remaining:",
    nrow(counts_fixed)
  )
)


############################################################
# CREATE COUNT MATRIX
############################################################

rownames(counts_fixed) <- counts_fixed$Geneid

counts <- counts_fixed[
  ,
  -1,
  drop = FALSE
]


############################################################
# 5. CREATE GENE ANNOTATION FOR COUNT MATRIX
############################################################

print("======================================================")
print("ANNOTATING GENES")
print("======================================================")


############################################################
# ORIGINAL SYSTEMATIC IDs
############################################################

original_gene_ids <- rownames(counts)


############################################################
# REMOVE CAALFM_ PREFIX IF PRESENT
############################################################

stripped_ids <- gsub(
  "^CAALFM_",
  "",
  original_gene_ids
)


############################################################
# NORMALIZE IDS FOR MATCHING
############################################################

normalized_ids <- normalize_id(
  stripped_ids
)


############################################################
# MATCH GENE NAMES
############################################################

matched_gene_names <- mapping_table$gene_symbol[
  match(
    normalized_ids,
    mapping_table$id_norm
  )
]


############################################################
# FALL BACK TO SYSTEMATIC ID WHEN NO NAME EXISTS
############################################################

display_gene_names <- ifelse(
  
  !is.na(matched_gene_names) &
    matched_gene_names != "",
  
  matched_gene_names,
  
  stripped_ids
  
)


############################################################
# CREATE MASTER GENE ANNOTATION TABLE
############################################################

gene_annotation <- data.frame(
  
  Systematic_ID = original_gene_ids,
  
  Gene_Name = display_gene_names,
  
  stringsAsFactors = FALSE
  
)


############################################################
# CHECK ANNOTATION SUCCESS
############################################################

mapped_count <- sum(
  !is.na(matched_gene_names) &
    matched_gene_names != ""
)

unmapped_count <- sum(
  is.na(matched_gene_names) |
    matched_gene_names == ""
)

print(
  paste(
    "Genes successfully mapped to gene names:",
    mapped_count
  )
)

print(
  paste(
    "Genes without CGD gene names:",
    unmapped_count
  )
)


############################################################
# SAVE GENE ANNOTATION TABLE
############################################################

write.csv(
  
  gene_annotation,
  
  file.path(
    output_dir,
    "02_DE_results",
    "Gene_ID_to_Gene_Name_Annotation.csv"
  ),
  
  row.names = FALSE
  
)


############################################################
# 6. CREATE SHORT SAMPLE NAMES
############################################################

print("======================================================")
print("CREATING SAMPLE METADATA")
print("======================================================")


############################################################
# IMPORTANT SAMPLE ORDER ASSUMPTION
#
# 1-3   WT +Pi
# 4-6   WT -Pi
# 7-9   kcs1 +Pi
# 10-12 kcs1 -Pi
#
# IF YOUR FEATURECOUNTS FILE HAS A DIFFERENT ORDER,
# CHANGE THESE VECTORS.
############################################################

genotype_vector <- c(
  "WT",
  "WT",
  "WT",
  
  "WT",
  "WT",
  "WT",
  
  "kcs1",
  "kcs1",
  "kcs1",
  
  "kcs1",
  "kcs1",
  "kcs1"
)


pi_vector <- c(
  "plus",
  "plus",
  "plus",
  
  "minus",
  "minus",
  "minus",
  
  "plus",
  "plus",
  "plus",
  
  "minus",
  "minus",
  "minus"
)


replicate_vector <- c(
  1,
  2,
  3,
  
  1,
  2,
  3,
  
  1,
  2,
  3,
  
  1,
  2,
  3
)


############################################################
# SHORT INTERNAL SAMPLE NAMES
#
# These MUST remain unique because DESeq2 needs each
# biological replicate separately.
############################################################

short_sample_names <- c(
  
  "WT_+Pi_1",
  "WT_+Pi_2",
  "WT_+Pi_3",
  
  "WT_-Pi_1",
  "WT_-Pi_2",
  "WT_-Pi_3",
  
  "kcs1_+Pi_1",
  "kcs1_+Pi_2",
  "kcs1_+Pi_3",
  
  "kcs1_-Pi_1",
  "kcs1_-Pi_2",
  "kcs1_-Pi_3"
  
)


############################################################
# HUMAN-READABLE SAMPLE NAMES
############################################################

display_sample_names <- c(
  
  "WT +Pi 1",
  "WT +Pi 2",
  "WT +Pi 3",
  
  "WT -Pi 1",
  "WT -Pi 2",
  "WT -Pi 3",
  
  "kcs1 +Pi 1",
  "kcs1 +Pi 2",
  "kcs1 +Pi 3",
  
  "kcs1 -Pi 1",
  "kcs1 -Pi 2",
  "kcs1 -Pi 3"
  
)


############################################################
# CHECK VECTOR LENGTHS
############################################################

if (
  length(genotype_vector) != 12 ||
  length(pi_vector) != 12 ||
  length(replicate_vector) != 12 ||
  length(short_sample_names) != 12 ||
  length(display_sample_names) != 12
) {
  
  stop(
    "ERROR: Sample metadata vectors must all contain exactly 12 entries."
  )
  
}


############################################################
# RENAME COUNT MATRIX
############################################################

colnames(counts) <- short_sample_names


############################################################
# CREATE METADATA
############################################################

metadata <- data.frame(
  
  Original_Sample_ID = original_sample_names,
  
  Sample_Name = short_sample_names,
  
  Display_Name = display_sample_names,
  
  Genotype = factor(
    genotype_vector,
    levels = c(
      "WT",
      "kcs1"
    )
  ),
  
  Pi = factor(
    pi_vector,
    levels = c(
      "plus",
      "minus"
    )
  ),
  
  Replicate = replicate_vector,
  
  stringsAsFactors = FALSE
  
)


############################################################
# SET ROW NAMES
############################################################

rownames(metadata) <- short_sample_names


############################################################
# CREATE FOUR-CONDITION VARIABLE
############################################################

metadata$Condition <- factor(
  
  paste(
    metadata$Genotype,
    metadata$Pi,
    sep = "_"
  ),
  
  levels = c(
    "WT_plus",
    "WT_minus",
    "kcs1_plus",
    "kcs1_minus"
  )
  
)


############################################################
# PRINT METADATA
############################################################

print("------------------------------------------------------")
print("SAMPLE METADATA")
print("------------------------------------------------------")

print(metadata)


############################################################
# VERIFY THREE REPLICATES PER CONDITION
############################################################

print("------------------------------------------------------")
print("REPLICATE COUNTS")
print("------------------------------------------------------")

print(
  table(
    metadata$Condition
  )
)


replicate_table <- table(
  metadata$Condition
)


if (!all(replicate_table == 3)) {
  
  stop(
    "ERROR: Every condition must contain exactly 3 biological replicates."
  )
  
}


print(
  "SUCCESS: Four conditions × three biological replicates."
)


############################################################
# SAVE METADATA
############################################################

write.csv(
  
  metadata,
  
  file.path(
    output_dir,
    "sample_metadata.csv"
  ),
  
  row.names = TRUE
  
)


############################################################
# 7. BUILD DESEQ2 OBJECT
############################################################

print("======================================================")
print("BUILDING DESEQ2 OBJECT")
print("======================================================")


dds <- DESeqDataSetFromMatrix(
  
  countData = round(
    as.matrix(counts)
  ),
  
  colData = metadata,
  
  design = ~ Genotype * Pi
  
)


############################################################
# 8. FILTER LOW-COUNT GENES
############################################################

print("======================================================")
print("FILTERING LOW-COUNT GENES")
print("======================================================")


print(
  paste(
    "Genes before filtering:",
    nrow(dds)
  )
)


keep <- rowSums(
  counts(dds)
) >= 10


dds <- dds[
  keep,
  ,
  drop = FALSE
]


print(
  paste(
    "Genes after filtering:",
    nrow(dds)
  )
)


############################################################
# 9. RUN DESEQ2
############################################################

print("======================================================")
print("RUNNING DESEQ2")
print("======================================================")


dds <- DESeq(
  dds
)


print("DESeq2 completed.")


############################################################
# PRINT MODEL COEFFICIENTS
############################################################

model_names <- resultsNames(
  dds
)

print("------------------------------------------------------")
print("DESeq2 MODEL COEFFICIENTS")
print("------------------------------------------------------")

print(model_names)


############################################################
# 10. IDENTIFY REQUIRED COEFFICIENTS
############################################################
#
# The exact interaction coefficient name can vary slightly
# depending on DESeq2's naming convention.
#
# We identify it from resultsNames(dds).
############################################################

genotype_candidates <- model_names[
  grepl(
    "^Genotype.*kcs1.*WT",
    model_names,
    ignore.case = TRUE
  )
]


pi_candidates <- model_names[
  grepl(
    "^Pi.*minus.*plus",
    model_names,
    ignore.case = TRUE
  )
]


interaction_candidates <- model_names[
  grepl(
    "Genotype.*kcs1.*Pi.*minus",
    model_names,
    ignore.case = TRUE
  )
]


print("------------------------------------------------------")
print("IDENTIFIED COEFFICIENTS")
print("------------------------------------------------------")

print(
  paste(
    "Genotype:",
    paste(
      genotype_candidates,
      collapse = ", "
    )
  )
)

print(
  paste(
    "Pi:",
    paste(
      pi_candidates,
      collapse = ", "
    )
  )
)

print(
  paste(
    "Interaction:",
    paste(
      interaction_candidates,
      collapse = ", "
    )
  )
)


############################################################
# MAKE SURE EXACTLY ONE COEFFICIENT WAS FOUND
############################################################

if (
  length(genotype_candidates) != 1 ||
  length(pi_candidates) != 1 ||
  length(interaction_candidates) != 1
) {
  
  stop(
    paste0(
      "\nERROR: Could not uniquely identify the DESeq2 ",
      "coefficients needed for the contrasts.\n\n",
      "Run:\n\n",
      "resultsNames(dds)\n\n",
      "and inspect the coefficient names above."
    )
  )
  
}


genotype_coef <- genotype_candidates[1]

pi_coef <- pi_candidates[1]

interaction_coef <- interaction_candidates[1]


############################################################
# 11. SAVE NORMALIZED COUNTS
############################################################

print("======================================================")
print("SAVING NORMALIZED COUNTS")
print("======================================================")


normalized_counts <- counts(
  dds,
  normalized = TRUE
)


############################################################
# ADD GENE NAMES TO NORMALIZED COUNTS
############################################################

normalized_counts_df <- as.data.frame(
  normalized_counts
)

normalized_counts_df$Systematic_ID <-
  rownames(
    normalized_counts_df
  )


normalized_counts_df$Gene_Name <-
  gene_annotation$Gene_Name[
    match(
      normalized_counts_df$Systematic_ID,
      gene_annotation$Systematic_ID
    )
  ]


############################################################
# PUT ANNOTATION COLUMNS FIRST
############################################################

normalized_counts_df <- normalized_counts_df[
  ,
  c(
    "Gene_Name",
    "Systematic_ID",
    setdiff(
      colnames(normalized_counts_df),
      c(
        "Gene_Name",
        "Systematic_ID"
      )
    )
  ),
  drop = FALSE
]


write.csv(
  
  normalized_counts_df,
  
  file.path(
    output_dir,
    "02_DE_results",
    "Normalized_counts_with_gene_names.csv"
  ),
  
  row.names = FALSE
  
)


############################################################
# 12. VST TRANSFORMATION
############################################################

print("======================================================")
print("PERFORMING VST TRANSFORMATION")
print("======================================================")


vsd <- vst(
  dds,
  blind = FALSE
)


vst_matrix <- assay(
  vsd
)


############################################################
# SAVE VST MATRIX WITH GENE NAMES
############################################################

vst_df <- as.data.frame(
  vst_matrix
)

vst_df$Systematic_ID <-
  rownames(vst_df)

vst_df$Gene_Name <-
  gene_annotation$Gene_Name[
    match(
      vst_df$Systematic_ID,
      gene_annotation$Systematic_ID
    )
  ]


vst_df <- vst_df[
  ,
  c(
    "Gene_Name",
    "Systematic_ID",
    setdiff(
      colnames(vst_df),
      c(
        "Gene_Name",
        "Systematic_ID"
      )
    )
  ),
  drop = FALSE
]


write.csv(
  
  vst_df,
  
  file.path(
    output_dir,
    "02_DE_results",
    "VST_expression_matrix_with_gene_names.csv"
  ),
  
  row.names = FALSE
  
)


############################################################
# 13. LIBRARY SIZE QC
############################################################

print("======================================================")
print("GENERATING LIBRARY SIZE PLOT")
print("======================================================")


library_sizes <- colSums(
  counts(dds)
)


library_df <- data.frame(
  
  Sample = names(library_sizes),
  
  Reads = as.numeric(
    library_sizes
  ),
  
  Condition = metadata[
    names(library_sizes),
    "Condition"
  ],
  
  Display_Name = metadata[
    names(library_sizes),
    "Display_Name"
  ],
  
  stringsAsFactors = FALSE
  
)


p_library <- ggplot(
  
  library_df,
  
  aes(
    x = Display_Name,
    y = Reads,
    fill = Condition
  )
  
) +
  
  geom_col() +
  
  theme_bw() +
  
  labs(
    title = "RNA-seq Library Sizes",
    x = "Sample",
    y = "Total Assigned Reads",
    fill = "Condition"
  ) +
  
