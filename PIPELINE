save_top_genes <- function(
    res,
    name
) {
  
  
  df <- annotate_DE_results(
    res
  )
  
  
  df$padj_numeric <-
    as.numeric(
      df$padj
    )
  
  
  df <- df[
    
    !is.na(
      df$padj_numeric
    ),
    
    ,
    drop = FALSE
    
  ]
  
  
  df <- df[
    
    order(
      df$padj_numeric
    ),
    
    ,
    drop = FALSE
    
  ]
  
  
  df$padj_numeric <- NULL
  
  
  top100 <- head(
    
    df,
    
    100
    
  )
  
  
  write.csv(
    
    top100,
    
    file.path(
      output_dir,
      "08_Significant_gene_lists",
      paste0(
        name,
        "_Top100_by_padj.csv"
      )
    ),
    
    row.names = FALSE
    
  )
  
}


