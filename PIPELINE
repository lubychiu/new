    result_df$Systematic_ID

  )

  result_df <- result_df[
    ,
    c(
      "Systematic_ID",
      "Gene_Name",
      "Display_Name",
      setdiff(
        colnames(result_df),
        c(
          "Systematic_ID",
          "Gene_Name",
          "Display_Name"
        )
      )
    )
  ]

  result_df

}


