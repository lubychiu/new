for (i in 2:ncol(counts_clean)) {

  counts_clean[[i]] <- as.numeric(
    as.character(
      counts_clean[[i]]
    )
  )

}


############################################################
# CHECK FOR NA VALUES
############################################################

if (any(is.na(counts_clean[, -1]))) {

  na_count <- sum(
    is.na(
      counts_clean[, -1]
    )
  )

  stop(
    paste0(
      "\nERROR: ",
