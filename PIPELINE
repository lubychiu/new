############################################################
# 22. FUNCTION TO ANNOTATE DE RESULTS
############################################################

annotate_DE_results <- function(
    res
) {
  
  df <- as.data.frame(
    res
  )
  
  
  ##########################################################
  # ORIGINAL SYSTEMATIC ID
  ##########################################################
  
  df$Systematic_ID <-
    rownames(df)
  
  
  ##########################################################
  # MATCH GENE NAME
  ##########################################################
  
  df$Gene_Name <-
    gene_annotation$Gene_Name[
      match(
        df$Systematic_ID,
        gene_annotation$Systematic_ID
      )
    ]
  
  
  ##########################################################
  # FALL BACK TO SYSTEMATIC ID
  ##########################################################
  
  missing_name <- (
    is.na(df$Gene_Name) |
      df$Gene_Name == ""
  )
  
  
  df$Gene_Name[
    missing_name
  ] <- df$Systematic_ID[
    missing_name
  ]
  
  
  ##########################################################
  # PUT GENE INFORMATION FIRST
  ##########################################################
  
  df <- df[
    ,
    c(
      "Gene_Name",
      "Systematic_ID",
      setdiff(
        colnames(df),
        c(
          "Gene_Name",
          "Systematic_ID"
        )
      )
    ),
    drop = FALSE
  ]
  
  
  return(df)
  
}


############################################################
# 23. FUNCTION TO SAVE DE RESULTS
############################################################

save_de_results <- function(
    res,
    comparison_name
) {
  
  
  df <- annotate_DE_results(
    res
  )
  
  
  ##########################################################
  # SORT BY ADJUSTED P-VALUE
  ##########################################################
  
  df$padj_numeric <- as.numeric(
    df$padj
  )
  
  
  df <- df[
    order(
      df$padj_numeric,
      na.last = TRUE
    ),
    ,
    drop = FALSE
  ]
  
  
  df$padj_numeric <- NULL
  
  
  ##########################################################
  # SAVE ALL GENES
  ##########################################################
  
  write.csv(
    
    df,
    
    file.path(
      output_dir,
      "02_DE_results",
      paste0(
        comparison_name,
        "_ALL_genes.csv"
      )
    ),
    
    row.names = FALSE
    
  )
  
  
  ##########################################################
  # SIGNIFICANT GENES
  #
  # padj < 0.05
  # |log2FC| >= 1
  ##########################################################
  
  sig <- df[
    
    !is.na(df$padj) &
      df$padj < 0.05 &
      !is.na(df$log2FoldChange) &
      abs(df$log2FoldChange) >= 1,
    
    ,
    drop = FALSE
    
  ]
  
  
  write.csv(
    
    sig,
    
    file.path(
      output_dir,
      "08_Significant_gene_lists",
      paste0(
        comparison_name,
        "_Significant_padj0.05_absLog2FC1.csv"
      )
    ),
    
    row.names = FALSE
    
  )
  
  
  ##########################################################
  # UPREGULATED
  ##########################################################
  
  sig_up <- sig[
    
    sig$log2FoldChange >= 1,
    
    ,
    drop = FALSE
    
  ]
  
  
  write.csv(
    
    sig_up,
    
    file.path(
      output_dir,
      "08_Significant_gene_lists",
      paste0(
        comparison_name,
        "_UP.csv"
      )
    ),
    
    row.names = FALSE
    
  )
  
  
  ##########################################################
  # DOWNREGULATED
  ##########################################################
  
  sig_down <- sig[
    
    sig$log2FoldChange <= -1,
    
    ,
    drop = FALSE
    
  ]
  
  
  write.csv(
    
    sig_down,
    
    file.path(
      output_dir,
      "08_Significant_gene_lists",
      paste0(
        comparison_name,
        "_DOWN.csv"
      )
    ),
    
    row.names = FALSE
    
  )
  
  
  ##########################################################
  # PRINT SUMMARY
  ##########################################################
  
  print(
    paste(
      comparison_name,
      "-> significant:",
      nrow(sig),
      "| up:",
      nrow(sig_up),
      "| down:",
      nrow(sig_down)
    )
  )
  
  
  return(df)
  
}


