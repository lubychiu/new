make_de_heatmap <- function(

  result_df,

  plot_title,

  output_file,

  n_genes = 50

) {

  significant_genes <- result_df %>%

    filter(
      !is.na(padj),
      padj < 0.05
    ) %>%

    arrange(
      padj
    )


  if (nrow(significant_genes) == 0) {

    print(
      paste(
        "No significant genes for:",
        plot_title
      )
    )

    return(NULL)

  }


  selected_genes <- head(
    significant_genes$Systematic_ID,
    n_genes
  )


  selected_genes <- intersect(
    selected_genes,
    rownames(vst_matrix)
  )


  if (length(selected_genes) < 2) {

    print(
      paste(
        "Too few genes for:",
        plot_title
      )
    )

    return(NULL)

  }


  heatmap_matrix <- vst_matrix[
    selected_genes,
    ,
    drop = FALSE
  ]


  gene_names <- gene_annotation$Gene_Name[
    match(
      rownames(heatmap_matrix),
      gene_annotation$Systematic_ID
    )
  ]


  gene_names[
    is.na(gene_names) |
      gene_names == ""
  ] <- rownames(
    heatmap_matrix
  )[
    is.na(gene_names) |
      gene_names == ""
  ]


  rownames(heatmap_matrix) <- make.unique(
    gene_names
  )


  heatmap_scaled <- t(
    scale(
      t(heatmap_matrix)
    )
  )


  png(

    output_file,

    width = 2400,

    height = 2600,

    res = 300

  )


  pheatmap(

    heatmap_scaled,

    scale = "none",

    annotation_col = annotation_col,

    cluster_rows = TRUE,

    cluster_cols = TRUE,

    show_rownames = TRUE,

    fontsize_row = 7,

    fontsize_col = 9,

    main = plot_title

  )


  dev.off()

}


