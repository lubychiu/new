  )

)


############################################################
# 25. CONDITION-LEVEL VST HEATMAP
############################################################
#
# Here, unlike DESeq2, we average the three biological
# replicates for each condition ONLY for visualization.
#
############################################################

print("======================================================")
print("CREATING CONDITION-LEVEL HEATMAP")
print("======================================================")


condition_means <- matrix(

  NA,

  nrow = nrow(vst_matrix),

  ncol = 4

)

colnames(condition_means) <- c(

  "WT +Pi",

  "WT -Pi",

  "kcs1 +Pi",

  "kcs1 -Pi"

)


condition_indices <- list(

  "WT +Pi" = which(
    metadata$Condition == "WT_plus"
  ),

  "WT -Pi" = which(
    metadata$Condition == "WT_minus"
  ),

  "kcs1 +Pi" = which(
    metadata$Condition == "kcs1_plus"
  ),

  "kcs1 -Pi" = which(
    metadata$Condition == "kcs1_minus"
  )

)


for (i in seq_along(condition_indices)) {

  condition_means[, i] <- rowMeans(

    vst_matrix[
      ,
      condition_indices[[i]],
      drop = FALSE
    ]

  )

}


############################################################
# SELECT TOP VARIABLE GENES
############################################################

condition_variances <- rowVars(
  condition_means
)

top_condition_genes <- names(
  sort(
    condition_variances,
    decreasing = TRUE
  )
)[
  1:min(
    50,
    length(condition_variances)
  )
]


condition_heatmap <- condition_means[
  top_condition_genes,
  ,
  drop = FALSE
]


############################################################
# GENE NAMES
############################################################

condition_gene_names <- gene_annotation$Gene_Name[
  match(
    rownames(condition_heatmap),
    gene_annotation$Systematic_ID
  )
]

condition_gene_names[
  is.na(condition_gene_names) |
    condition_gene_names == ""
] <- rownames(
  condition_heatmap
)[
  is.na(condition_gene_names) |
    condition_gene_names == ""
]


rownames(condition_heatmap) <- make.unique(
  condition_gene_names
)


############################################################
# SCALE GENES
############################################################

condition_heatmap_scaled <- t(
  scale(
    t(condition_heatmap)
  )
)


############################################################
# CREATE CONDITION-LEVEL HEATMAP
############################################################

png(

  file.path(
    output_dir,
    "05_Heatmaps",
    "Heatmap_Top_50_Variable_Condition_Means.png"
  ),

  width = 1800,

  height = 2400,

  res = 300

)

pheatmap(

